# このファイルはローカル開発専用のサンプル設定。本番では絶対に使わない。

# Better Auth
BETTER_AUTH_SECRET=6704f82ef5776dc27f98f9455de4b62d0c856a16e6f90ea8c3518a28aa7ff0e8
BETTER_AUTH_URL=http://localhost:3000

# Database (既存の sample DB を利用)
DATABASE_URL=postgres://db_user:db_password@localhost:5432/sample

# OIDC (Dex / ローカル開発用)
# Dex は discovery が完全なので OIDC_ISSUER だけで authorize / token / userinfo に到達できる。
# 本物の Amazon Cognito で試す場合は scripts/cognito-up.sh が生成する .env.aws を使う (pnpm dev:aws)。
OIDC_ISSUER=http://localhost:5556/dex
OIDC_CLIENT_ID=tanstack-start-app
OIDC_CLIENT_SECRET=tanstack-start-app-secret
