# このファイルはローカル開発専用のサンプル設定。本番では絶対に使わない。

# Better Auth
BETTER_AUTH_SECRET=6704f82ef5776dc27f98f9455de4b62d0c856a16e6f90ea8c3518a28aa7ff0e8
BETTER_AUTH_URL=http://localhost:3000

# Database (既存の sample DB を利用)
DATABASE_URL=postgres://db_user:db_password@localhost:5432/sample

# OIDC (Cognito Local)
# OIDC_ISSUER は User Pool ID を含む。シード済み Pool の固定 ID を使う。
# id_token の iss 検証と jwks 取得はこの URL から行う。
OIDC_ISSUER=http://localhost:9229/local_cognitosample
# authorize / token は Pool ID を含まない /oauth2/* 配下にあるため、ベース URL を分けて持つ。
OIDC_AUTH_BASE=http://localhost:9229
OIDC_CLIENT_ID=77ofdox0wwp9f60c453exwhhx
OIDC_CLIENT_SECRET=c7rlf6tt2jydwztzwtk7xdspk
